# Copiar a apps/server/.env para correr el servidor fuera de Docker (npm run dev:server)
PORT=3000
# Postgres de docker compose (publicado solo en esta laptop, puerto 55432)
DATABASE_URL=postgresql://astro:astro@127.0.0.1:55432/astro
# Respaldo HTTP de la pulsera: header x-api-key
DEVICE_API_KEYS=dev-key
GROUND_DELAY_SEC=60
OFFLINE_AFTER_SEC=10
# 0.1 = las reglas esperan 10 veces menos (útil para la demo)
RULE_TIME_SCALE=1
BASELINE_SAMPLES=30
CORS_ORIGIN=*
SIM_ENABLED=true

# Broker Mosquitto (docker compose). Usuario y clave salen de MQTT_SERVER_PASS en el .env de la raíz.
MQTT_ENABLED=true
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=server
MQTT_PASS=clave-server
