# Copiar a apps/server/.env para correr el servidor fuera de Docker (npm run dev:server)
PORT=3000
DATABASE_URL=postgresql://astro:astro@127.0.0.1:55432/astro
DEVICE_API_KEYS=dev-key
GROUND_DELAY_SEC=60
OFFLINE_AFTER_SEC=10
# 0.1 = las reglas esperan 10 veces menos (útil para la demo)
RULE_TIME_SCALE=1
BASELINE_SAMPLES=30
CORS_ORIGIN=*

# Broker Mosquitto (docker compose crea estos usuarios al arrancar)
MQTT_SERVER_PASS=clave-server
MQTT_DEVICE_USER=node-01
MQTT_DEVICE_PASS=clave-node-01
MQTT_TEST_PASS=clave-test-01
SIM_ENABLED=true
